# Productie-omgeving voor de workers (Hetzner) — kopieer naar .env.production en vul in. Nooit committen.
# De web-app (Vercel) krijgt dezelfde variabelen via de Vercel-omgeving (zie docs/DEPLOY.md).
NODE_ENV=production
DATA_MODE=live
APP_URL=https://app.trendscope.example

DATABASE_URL=postgresql://trendscope:CHANGE_ME@db.internal:5432/trendscope?sslmode=require
CLICKHOUSE_URL=http://trendscope:CHANGE_ME@clickhouse:8123/trendscope
CLICKHOUSE_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME

# 32 willekeurige bytes, base64 (openssl rand -base64 32) — gedeeld met de web-app
APP_ENCRYPTION_KEY=
AUTH_SECRET=

S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=trendscope-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

CRAWLER_USER_AGENT="TrendscopeBot/1.0 (+https://trendscope.example/bot)"
RESEND_API_KEY=
EMAIL_FROM="Trendscope <alerts@trendscope.example>"
ANTHROPIC_API_KEY=

# Officiële bronnen (leeg = connector staat uit)
META_AD_LIBRARY_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

WORKER_CONCURRENCY=4
WORKER_REPLICAS=1
