{
  "name": "trendscope",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "dbmate --migrations-dir db/postgres/migrations --schema-file db/postgres/schema.sql up",
    "db:rollback": "dbmate --migrations-dir db/postgres/migrations --schema-file db/postgres/schema.sql down",
    "db:codegen": "kysely-codegen --dialect postgres --numeric-parser number --date-parser string --out-file packages/db/src/generated.ts --exclude-pattern schema_migrations"
  },
  "devDependencies": {
    "dbmate": "^2.26.0",
    "kysely-codegen": "^0.17.0",
    "pg": "^8.23.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
