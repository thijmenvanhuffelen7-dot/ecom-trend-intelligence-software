# ── Algemeen ──────────────────────────────────────────────
APP_ENV=development
# mock = connectors lezen fixtures; live = echte bronnen (vereist API-keys en juridisch akkoord)
DATA_MODE=mock

# ── Databases (zie infra/docker/docker-compose.dev.yml) ──
DATABASE_URL=postgresql://trendscope:trendscope@localhost:5432/trendscope?sslmode=disable
CLICKHOUSE_URL=http://trendscope:trendscope@localhost:8123/trendscope
REDIS_URL=redis://localhost:6379/0
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-master-key

# ── Auth ─────────────────────────────────────────────────
# dev = inloggen met alleen een e-mailadres (lokaal, geen keys nodig); clerk = productie
AUTH_MODE=dev
# Minimaal 32 tekens; ondertekent de dev-sessiecookie. Genereer met: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-min
# 32 bytes base64 (openssl rand -base64 32): versleutelt kanaalsecrets (webhook-URL's, bot-tokens). Verplicht in productie.
APP_ENCRYPTION_KEY=
# Toegang tot /admin (komma-gescheiden e-mails of "@domein"). Dev/e2e: alle @trendscope.dev-logins.
PLATFORM_ADMIN_EMAILS=@trendscope.dev
# Beveiligt /api/cron/* (Vercel Cron stuurt "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=dev-cron-secret-change-me
# Transactionele e-mail (digests, e-mailalerts). Leeg = alleen gelogd in outbound_emails.
RESEND_API_KEY=
EMAIL_FROM="Trendscope <alerts@trendscope.example>"
APP_URL=http://localhost:3000
# AI (fase 9) — leeg = offline-modus (regelgebaseerd, zelfde data)
ANTHROPIC_API_KEY=
# Optioneel: lokaal faster-whisper-model voor transcriptie van video-ads (bv. "small"); leeg = overslaan
WHISPER_MODEL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Crawler ──────────────────────────────────────────────
CRAWLER_USER_AGENT="TrendscopeBot/0.1 (+https://trendscope.example/bot)"

# ── Ad intelligence (fase 3) — leeg laten in mock-modus ─
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
# Creatives uit Meta-snapshots kopiëren: pas aanzetten na juridisch akkoord
META_SNAPSHOT_CAPTURE=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Marktplaatsen (fase 4) — leeg = mockdata in DATA_MODE=mock
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.de
CJ_API_KEY=
MARKETPLACE_SHIP_TO=NL
# Productafbeeldingen van marktplaatsen naar eigen S3 kopiëren (pas na juridisch akkoord)
STORE_MARKETPLACE_IMAGES=false
# Trends (fase 5) — leeg = mockdata in DATA_MODE=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TREND_COUNTRY=NL
# Social (fase 6) — leeg = mockdata in DATA_MODE=mock
TIKTOK_PARTNER_BASE_URL=https://api.tiktok-data-partner.example
TIKTOK_PARTNER_API_KEY=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# E-mail (fase 7) — seed-mailbox op een eigen domein; leeg = mockdata in DATA_MODE=mock
EMAIL_SEED_LOCAL=inbox
EMAIL_SEED_DOMAIN=seeds.trendscope.example
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_TRACK_STORES=40
# Google Ads Transparency via BigQuery: pad naar service-account-JSON
GOOGLE_APPLICATION_CREDENTIALS=

# ── Billing (fase 10) ────────────────────────────────────
# Leeg = demo-checkout: plannen werken in de app, er wordt niets afgerekend (duidelijk gelabeld).
# Met Stripe: Checkout (trial 7 dagen, Stripe Tax voor btw, btw-nummer), klantportaal en webhooks.
STRIPE_SECRET_KEY=
# Webhook-endpoint: <APP_URL>/api/webhooks/stripe (lokaal: stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Prijs-ID's (price_…) per plan en interval; maak ze in Stripe als terugkerende prijzen in EUR
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=trendscope-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
# Pad naar Chromium voor Playwright (screenshots); leeg = Playwright-standaard
CHROME_PATH=
