# ── Algemeen ──────────────────────────────────────────────
APP_ENV=development
# mock = connectors lezen fixtures; live = echte bronnen (vereist API-keys en juridisch akkoord)
DATA_MODE=mock

# ── Databases (zie infra/docker/docker-compose.dev.yml) ──
DATABASE_URL=postgresql://trendscope:trendscope@localhost:5432/trendscope?sslmode=disable
CLICKHOUSE_URL=http://trendscope:trendscope@localhost:8123/trendscope
REDIS_URL=redis://localhost:6379/0
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-master-key

# ── Auth ─────────────────────────────────────────────────
# dev = inloggen met alleen een e-mailadres (lokaal, geen keys nodig); clerk = productie
AUTH_MODE=dev
# Minimaal 32 tekens; ondertekent de dev-sessiecookie. Genereer met: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-min
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Crawler ──────────────────────────────────────────────
CRAWLER_USER_AGENT="TrendscopeBot/0.1 (+https://trendscope.example/bot)"

# ── Ad intelligence (fase 3) — leeg laten in mock-modus ─
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
# Creatives uit Meta-snapshots kopiëren: pas aanzetten na juridisch akkoord
META_SNAPSHOT_CAPTURE=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Marktplaatsen (fase 4) — leeg = mockdata in DATA_MODE=mock
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.de
CJ_API_KEY=
MARKETPLACE_SHIP_TO=NL
# Productafbeeldingen van marktplaatsen naar eigen S3 kopiëren (pas na juridisch akkoord)
STORE_MARKETPLACE_IMAGES=false
# Google Ads Transparency via BigQuery: pad naar service-account-JSON
GOOGLE_APPLICATION_CREDENTIALS=

# ── Later (fase 9+) ──────────────────────────────────────
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=trendscope-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
# Pad naar Chromium voor Playwright (screenshots); leeg = Playwright-standaard
CHROME_PATH=
